{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-gale.example/schemas/music.schema.json",
  "title": "Music Profile Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tracks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_.-]+$"
    },
    "display_name_key": {
      "type": "string"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "stream"
        ],
        "properties": {
          "state": {
            "enum": [
              "explore",
              "combat",
              "tension",
              "village",
              "sailing",
              "shrine",
              "night",
              "boss",
              "credits"
            ]
          },
          "stream": {
            "type": "string",
            "description": "OGG Vorbis recomendado. WAV sólo para one-shots cortos."
          },
          "loop": {
            "type": "boolean",
            "default": true
          },
          "loop_begin": {
            "type": "number",
            "minimum": 0
          },
          "loop_end": {
            "type": "number",
            "minimum": 0
          },
          "volume_db": {
            "type": "number",
            "minimum": -60,
            "maximum": 6,
            "default": 0
          },
          "intensity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 0,
            "description": "Capa dentro del mismo estado. Permite subir intensidad sin cambiar de pista."
          }
        }
      }
    },
    "crossfade_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "default": 2
    },
    "silence_between_seconds": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Rango de silencio entre repeticiones en exploración."
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Resuelve conflicto cuando dos perfiles compiten, por ejemplo bioma contra combate."
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "description": "Obligatorio para audio de terceros. Se replica en THIRD_PARTY.md."
    }
  }
}
