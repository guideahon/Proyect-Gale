{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ability Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "trigger",
    "actions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_.-]+$"
    },
    "trigger": {
      "type": "string"
    },
    "cooldown": {
      "type": "number",
      "minimum": 0
    },
    "cost": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
