{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-gale.example/schemas/spawn_table.schema.json",
  "title": "Spawn Table Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entries",
    "max_active"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_.-]+$"
    },
    "max_active": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "description": "Tope simultáneo de esta tabla. El presupuesto de docs/03 admite 3–5 enemigos de combate; el núcleo recorta si el total del sector se excede."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition",
          "weight"
        ],
        "properties": {
          "definition": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+:[a-z0-9_.-]+$",
            "description": "ID de enemigo, NPC u objeto ya registrado."
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "min_count": {
            "type": "integer",
            "minimum": 0,
            "default": 1
          },
          "max_count": {
            "type": "integer",
            "minimum": 0,
            "default": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "has_item",
                    "stat_compare",
                    "target_has_tag",
                    "random_chance",
                    "quest_state",
                    "environment_tag",
                    "cooldown_ready"
                  ]
                }
              }
            },
            "description": "Whitelist de condiciones de docs/09. Cualquier otro tipo se rechaza."
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "surface",
            "anchor",
            "volume",
            "water"
          ],
          "default": "surface"
        },
        "anchor_tag": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "slope_max_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "min_distance_from_player": {
          "type": "number",
          "minimum": 0,
          "default": 12,
          "description": "Evita aparición dentro del campo visual inmediato, que en VR resulta agresiva."
        },
        "min_distance_between": {
          "type": "number",
          "minimum": 0
        },
        "require_navmesh": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "time_of_day": {
      "type": "array",
      "items": {
        "enum": [
          "dawn",
          "day",
          "dusk",
          "night"
        ]
      },
      "uniqueItems": true
    },
    "respawn_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "0 desactiva el respawn. El estado se conserva aunque el sector esté descargado."
    },
    "respawn_requires_unload": {
      "type": "boolean",
      "default": true,
      "description": "Nada reaparece dentro del anillo activo mientras el jugador mira."
    },
    "biome_filter": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+:[a-z0-9_.-]+$"
      }
    },
    "sector_filter": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+:[a-z0-9_.-]+$"
      }
    }
  }
}
