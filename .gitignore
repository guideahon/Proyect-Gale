# Caché de importación de Godot: se regenera, nunca se versiona.
.godot/
.import/
*.import

# Binarios del motor y de exportación. El motor se fija por versión en
# VERSION_BASELINE.md, no por copia en el repositorio.
Godot_v*
*.exe
*.apk
*.aab
*.keystore
*.jks
exports/

# Godot escribe la contraseña del keystore dentro de export_presets.cfg.
# M0 debe versionar `export_presets.template.cfg` sin credenciales y hacer que
# el CI lo complete desde secretos; sin eso la build reproducible no cierra.
export_presets.cfg

# Plantilla de build Gradle de Android: la instala el editor (o se extrae del
# .tpz) y pesa cientos de MB. Se regenera; no se versiona.
android/

# Addons de terceros: 82 MB de binarios por plataforma. Se bajan del release
# fijado con tools/deploy/fetch_addons.ps1, que verifica el SHA-256.
# El lockfile sí se versiona: es lo que define qué versión va.
addons/*
!addons/LOCKFILE.md

# Herramientas
__pycache__/
*.pyc
.venv/

# Sistema
.DS_Store
Thumbs.db

# Agent tooling
.llamacode/
.playwright-mcp/
