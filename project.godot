; Project Gale — configuración mínima.
;
; Sólo lo necesario para importar el proyecto y ejecutar tests headless:
;
;     godot --headless --script tests/unit/test_semver.gd
;
; El renderer, OpenXR, los perfiles de rendimiento y el preset de exportación
; Android se fijan en M0, después de cerrar ADR-011. Ver docs/23.

config_version=5

[application]

config/name="Project Gale"
config/description="Aventura VR de mundo abierto, libre y centrada en mods."
run/main_scene=""

[editor]

script/search_in_file_extensions=PackedStringArray("gd", "gdshader")
